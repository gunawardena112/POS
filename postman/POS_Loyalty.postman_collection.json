    {
      "name": "2. Orders & loyalty",
      "item": [
        {
          "name": "Order 1: new customer, 2 notebooks + 3 pens (Rs 940, 9 pts)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
