              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"fullName\": \"Nimal Perera\",\n    \"mobileNumber\": \"0771234567\",\n    \"email\": \"nimal@example.com\"\n  },\n  \"items\": [\n    {\n      \"productId\": \"{{prd001}}\",\n      \"quantity\": 2\n    },\n    {\n      \"productId\": \"{{prd002}}\",\n      \"quantity\": 3\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.test('total 940', () => pm.expect(d.totalAmount).to.eql(940));",
                  "pm.test('9 points', () => pm.expect(d.loyaltyPointsEarned).to.eql(9));",
                  "pm.test('canonical mobile', () => pm.expect(d.customer.mobileNumber).to.eql('+94771234567'));"
                ]
              }
            }
          ]
        },
